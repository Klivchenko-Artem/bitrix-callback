{
    "name": "klivchenko/bitrix-callback",
    "description": "Модуль и компонент обратного звонка для 1С-Битрикс",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Artem\\Callback\\": "local/modules/artem.callback/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Artem\\Callback\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
